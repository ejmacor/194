# 194 — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real keys.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=          # anon / public key — safe in client apps
SUPABASE_SERVICE_ROLE_KEY=  # server-only — bypasses RLS, never ship to client

# Resend (transactional email — Phase 0 step 4)
RESEND_API_KEY=
